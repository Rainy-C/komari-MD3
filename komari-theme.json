{
  "name": {
    "zh-CN": "Komari · 新拟态",
    "en": "Komari · Neumorph"
  },
  "short": "MD3",
  "description": {
    "zh-CN": "柔和阴影与内凹控件的新拟态监控主题",
    "en": "A quiet neumorphic monitoring theme"
  },
  "version": "0.2.1",
  "author": "Rainy-C",
  "url": "https://github.com/Rainy-C/komari-MD3",
  "configuration": {
    "type": "managed",
    "icon": "Palette",
    "name": "新拟态主题设置",
    "data": [
      {
        "name": "外观与内容",
        "type": "title"
      },
      {
        "key": "seed_color",
        "name": "强调色",
        "type": "string",
        "default": "#446b9e",
        "help": "十六进制颜色，例如 #446b9e。"
      },
      {
        "key": "headline",
        "name": "首页标题",
        "type": "string",
        "default": "服务器概览"
      },
      {
        "key": "description",
        "name": "首页说明",
        "type": "string",
        "default": ""
      },
      {
        "key": "default_appearance",
        "name": "默认外观",
        "type": "select",
        "options": "system,light,dark",
        "default": "system"
      },
      {
        "key": "show_traffic",
        "name": "显示累计流量",
        "type": "switch",
        "default": true
      },
      {
        "key": "show_uptime",
        "name": "显示运行时间",
        "type": "switch",
        "default": true
      },
      {
        "key": "refresh_seconds",
        "name": "实时刷新间隔（秒）",
        "type": "number",
        "default": 3,
        "help": "有效范围 2–30 秒"
      }
    ]
  }
}
